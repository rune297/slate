{
  "name": "slate",
  "version": "1.5.0",
  "description": "Slate - a Windows desktop workspace for tasks, notes, clipboard tools and configurable AI",
  "main": "main.js",
  "author": "Rune",
  "license": "MIT",
  "homepage": "https://github.com/rune297/slate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rune297/slate.git"
  },
  "bugs": {
    "url": "https://github.com/rune297/slate/issues"
  },
  "keywords": [
    "electron",
    "productivity",
    "windows",
    "todo",
    "workspace"
  ],
  "scripts": {
    "pretest":"node scripts/build-native.js",
    "prestart":"node scripts/build-native.js",
    "prebuild":"node scripts/build-native.js",
    "prebuild:win":"node scripts/build-native.js",
    "prepack":"node scripts/build-native.js",
    "test": "node scripts/test-desktop.js",
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.slate.app",
    "productName": "Slate",
    "artifactName": "slate-${version}-${arch}.${ext}",
    "copyright": "© 2026 Rune",
    "asar": true,
    "extraResources":[{"from":"build/native/slate-clipboard-observer.exe","to":"native/slate-clipboard-observer.exe"}],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main-services.js",
      "translation-service.cjs",
      "translation-worker.cjs",
      "todo-reminders.cjs",
      "todo-attachments.cjs",
      "report-service.cjs",
      "ai-provider-service.cjs",
      "ai-catalog.cjs",
      "ai-chat.cjs",
      "ai-hub-service.cjs",
      "prompt-optimizer.cjs",
      "copy-feedback.cjs",
      "copy-feedback-preload.js",
      "todo-reminder-preload.js",
      "platform.js",
      "hotzone.html",
      "build/slate-icon.png",
      "preload.js",
      "quick-capture-preload.js",
      "renderer/**/*",
      "scripts/codex-notify.js",
      "scripts/claude-notify.js",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}"
    ],
    "win": {
      "icon": "build/slate-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "slate-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "franc-min": "^6.2.0",
    "undici": "^7.29.0",
    "ws": "^8.21.3"
  }
}
